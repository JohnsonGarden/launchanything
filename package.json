{
  "name": "launchanything",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "npm run prepare:macos && vite --host 127.0.0.1",
    "web:build": "npm run prepare:macos && tsc --noEmit && vite build",
    "prepare:macos": "bash scripts/prepare-macos.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "doctor": "node scripts/doctor.mjs",
    "predev": "npm run doctor",
    "prebuild": "npm run doctor",
    "test:doctor": "node --test scripts/doctor.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-dialog": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "tailwindcss": "4.1.12"
  },
  "overrides": {
    "rollup": "4.62.3"
  }
}
