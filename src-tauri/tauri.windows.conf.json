    "beforeBuildCommand": "npm run web:build:windows"
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": null,
